{
  "name": "meshNest",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Gustavo Warmling Teixeira",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "dist:mas": "npm run build && electron-builder --mac mas"
  },
  "build": {
    "appId": "app.meshnest.desktop",
    "productName": "meshNest",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/node_modules/@rollup/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/**"
    ],
    "asarUnpack": [
      "**/node_modules/@duckdb/**",
      "**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "**/node_modules/onnxruntime-node/dist/**",
      "**/node_modules/onnxruntime-node/package.json",
      "**/node_modules/@huggingface/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "mas"
      ],
      "extendInfo": {
        "ElectronTeamID": "P5VE23TX58"
      }
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "build/entitlements.mas.loginhelper.plist",
      "provisioningProfile": "build/meshnest_mas.provisionprofile",
      "preAutoEntitlements": false
    }
  },
  "dependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/status-bar": "8.0.2",
    "@duckdb/node-api": "^1.5.3-r.3",
    "@huggingface/transformers": "^4.2.0",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "ionicons": "^7.0.0",
    "three": "^0.184.0",
    "vue": "^3.3.0",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0",
    "@lancedb/lancedb": "0.22.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "better-sqlite3": "^13.0.3",
    "cypress": "^13.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "sqlite-vec": "^0.1.9",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^1.0.4",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "description": "An Ionic project",
  "allowScripts": {
    "esbuild@0.21.5": true,
    "onnxruntime-node@1.24.3": true
  }
}
